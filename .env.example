# ============================================================================
# SPRING PROFILE
# ============================================================================
# dev (default) = verbose logging, SQL logging, mail debug.
# prod = quiet logging, no stack traces in error responses. Use this for any
# real deployment.
SPRING_PROFILES_ACTIVE=dev

# ============================================================================
# JWT SIGNING SECRET
# ============================================================================
# REQUIRED. The app refuses to start without a real value here.
# Generate one with: openssl rand -base64 64
JWT_SECRET=

# ============================================================================
# DEMO DATA SEEDING
# ============================================================================
# Seeds sample users (incl. an admin account), machines, finance, and
# inventory data on first boot against an empty database. Leave false/unset
# in any shared or production environment.
SEED_DEMO_DATA=false

# ============================================================================
# TELEMETRY REPLAY
# ============================================================================
# Real NASA C-MAPSS data to replay as live telemetry. Points at the dataset
# files shipped in the ml_service repo. Leave empty and replay just stays
# idle (logged as a warning, not fatal).
TELEMETRY_DATASET_RESOURCES=file:../ml_service/data/train_FD001.txt

# ============================================================================
# DATABASE
# ============================================================================
DB_URL=jdbc:postgresql://localhost:5432/pfe
DB_USERNAME=postgres
DB_PASSWORD=

# ============================================================================
# GMAIL SMTP
# ============================================================================
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
OPENAI_API_KEY=your_new_openai_api_key_here

# ============================================================================
# ML MICROSERVICES - INTERNAL SECURITY
# ============================================================================
# Shared secret key for X-Internal-Key header on all internal ML calls.
# Must match ML_INTERNAL_API_KEY in ml_service's environment.
# Change this value in production to a strong random string.
ML_INTERNAL_API_KEY=sentinel-dev-secret

# ml_service (FastAPI) serves prediction, face recognition, and NLP endpoints
# from a single process - one URL for all three, not separate services.
ML_PREDICTIVE_URL=http://localhost:8000
ML_FACE_URL=http://localhost:8000
NLP_SERVICE_URL=http://localhost:8000

# ============================================================================
# ML SERVICE ADVANCED CONFIGURATION (Optional)
# ============================================================================
ML_SERVICE_BASE_URL=http://127.0.0.1:8000
ML_SERVICE_CONNECT_TIMEOUT=2s
ML_SERVICE_READ_TIMEOUT=5s
ML_SERVICE_RETRY_MAX_ATTEMPTS=3
ML_SERVICE_RETRY_BACKOFF=200ms
ML_SERVICE_AUTH_HEADER_NAME=
ML_SERVICE_AUTH_HEADER_VALUE=
ML_RATE_LIMIT_ENABLED=true
ML_RATE_LIMIT_RPM=60
