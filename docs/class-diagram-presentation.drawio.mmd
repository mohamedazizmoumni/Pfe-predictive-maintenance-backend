classDiagram
direction LR

%% Diagramme de presentation : les namespaces deviennent des groupes visuels dans draw.io.

namespace "SECURITE ET UTILISATEURS" {
  class User {
    +Long id
    +String username
    +String email
    +UserStatus status
    +Boolean locked
  }
  class Role {
    +Long id
    +String name
  }
  class Permission {
    +Long id
    +String name
  }
  class UserPreference {
    +Long id
    +String prefKey
    +String prefValue
  }
  class UserStatus {
    <<enumeration>>
    ACTIVE
    INACTIVE
    LOCKED
    PENDING
  }
}

namespace "PARC MACHINES ET CAPTEURS" {
  class Machine {
    +Long id
    +String serialNumber
    +String name
    +String model
    +String location
    +String status
    +Double riskScore
  }
  class Sensor {
    +Long id
    +String code
    +String type
    +String unit
    +String status
    +Double lastReadingValue
  }
  class SensorData {
    +Long id
    +Double value
    +LocalDateTime recordedDate
    +Boolean isAnomaly
  }
  class SensorTelemetry {
    +Long id
    +Long machineId
    +LocalDateTime timestamp
    +Double settings
    +Double sensorValues
  }
  class EnvironmentalTelemetry {
    +Long id
    +Double temperature
    +Double humidity
    +String riskLevel
    +LocalDateTime timestamp
  }
  class MachineEvent {
    +Long id
    +Long machineId
    +String eventType
    +String severity
    +Boolean acknowledged
    +LocalDateTime eventTimestamp
  }
  class MachineSimulationState {
    +Long id
    +Long machineId
    +Double health
    +Double efficiencyScore
    +Double loadFactor
  }
  class MachineStatus {
    <<enumeration>>
    OPERATIONAL
    WARNING
    CRITICAL
    OFFLINE
    MAINTENANCE
  }
}

namespace "MAINTENANCE" {
  class Maintenance {
    +Long id
    +Long machineId
    +MaintenanceType type
    +MaintenancePriority priority
    +MaintenanceStatus status
    +LocalDateTime scheduledDate
    +Long assignedTechnicianId
  }
  class Task {
    +Long id
    +String title
    +String status
    +String priority
    +Long machineId
    +Long maintenanceId
    +LocalDateTime dueDate
  }
  class MaintenanceRecommendation {
    +Long id
    +Long machineId
    +String recommendedAction
    +Double failureProbability
    +Integer daysUntilFailure
    +RecommendationStatus status
  }
  class MachineTechnicianAssignment {
    +Long id
    +Long machineId
    +Long technicianId
    +LocalDateTime assignedAt
  }
  class WorkOrderTemplate {
    +Long id
    +String name
    +MaintenanceType type
    +Integer estimatedDuration
    +Boolean active
  }
  class RecurringMaintenanceRule {
    +Long id
    +Long machineId
    +Long templateId
    +Integer intervalDays
    +LocalDateTime nextRunDate
    +Boolean active
  }
  class MaintenanceType {
    <<enumeration>>
    PREVENTIVE
    CORRECTIVE
    PREDICTIVE
    EMERGENCY
  }
  class MaintenancePriority {
    <<enumeration>>
    LOW
    MEDIUM
    HIGH
    CRITICAL
  }
  class MaintenanceStatus {
    <<enumeration>>
    PLANNED
    IN_PROGRESS
    COMPLETED
    CANCELLED
    PENDING_APPROVAL
  }
  class RecommendationStatus {
    <<enumeration>>
    PENDING
    APPROVED
    REJECTED
    EXECUTED
  }
}

namespace "INTELLIGENCE PREDICTIVE" {
  class PredictionRecord {
    +Long id
    +Long machineId
    +Double rulValue
    +Double confidenceLow
    +Double confidenceHigh
    +RiskLevel riskLevel
    +String modelVersion
    +LocalDateTime predictedAt
  }
  class PredictionHistory {
    +Long id
    +Long machineId
    +Double health
    +Double predictedRUL
    +Double anomalyProbability
    +Double failureProbability
    +String recommendedAction
    +LocalDateTime timestamp
  }
  class Alert {
    +Long id
    +Long machineId
    +String title
    +AlertSeverity severity
    +AlertStatus status
    +AlertCategory category
    +Double predictedRUL
    +Double anomalyProbability
  }
  class Notification {
    +Long id
    +Long machineId
    +Long predictionRecordId
    +String title
    +RiskLevel riskLevel
    +Boolean isRead
  }
  class RiskLevel {
    <<enumeration>>
    LOW
    MEDIUM
    HIGH
    CRITICAL
  }
  class AlertSeverity {
    <<enumeration>>
    INFO
    WARNING
    HIGH
    CRITICAL
  }
  class AlertStatus {
    <<enumeration>>
    NEW
    ACKNOWLEDGED
    ESCALATED
    RESOLVED
    CLOSED
  }
  class AlertCategory {
    <<enumeration>>
    PREDICTIVE
    ANOMALY
    SENSOR
    MAINTENANCE
    SYSTEM
  }
}

namespace "GESTION DE STOCK" {
  class Part {
    +Long id
    +String partNumber
    +String name
    +Integer currentStock
    +Integer minimumStock
    +BigDecimal cost
