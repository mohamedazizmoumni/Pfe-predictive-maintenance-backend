%% Relations JPA
User "*" -- "*" Role : roles
Role "*" -- "*" Permission : permissions
CoreMachine "1" *-- "0..*" Sensor : sensors
Sensor "1" -- "0..*" SensorData : readings
CoreMachine "1" -- "0..*" EnvironmentalTelemetry : telemetry
CoreMachine "1" -- "0..*" MachineTechnicianAssignment : assignments
MachineTechnicianAssignment "*" --> "1" User : technician
MachineTechnicianAssignment "*" --> "1" User : assignedBy
InventoryUsage "*" --> "1" Part : part
ReorderRequest "*" --> "1" Part : part
StockOrder "*" --> "1" Part : part
StockOrder "1" -- "1" ReorderRequest : reorderRequest
StockOrder "*" --> "0..1" Supplier : supplier
MachineFailureReport "1" *-- "0..*" MachineFailureReportPart : requiredParts
CostMachine "1" -- "0..*" FailureEvent : failures
CostMachine "1" -- "0..*" MaintenanceAction : actions
MaintenanceAction "*" -- "*" MaintenancePart : parts
MaintenanceRapport "1" *-- "0..*" RapportPart : parts
MaintenanceRapport "1" *-- "0..*" ChecklistItem : checklist
SupportTicket "1" *-- "0..*" PortalMessage : messages

