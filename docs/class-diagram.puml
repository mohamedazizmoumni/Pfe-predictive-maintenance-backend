@startuml
!theme plain
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 35

title Diagramme de classes detaille - Sentinel Predictive Maintenance

legend right
  -- Association JPA declaree
  .. Reference logique par identifiant Long ..
  ..> Dependance fonctionnelle
endlegend

package "Core - Utilisateurs et securite" {
  class User {
    +id: Long
