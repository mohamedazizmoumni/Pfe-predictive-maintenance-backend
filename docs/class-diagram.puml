    +faceEnrolledAt: LocalDateTime
    +createdAt: LocalDateTime
    +updatedAt: LocalDateTime
    +lastLoginAt: LocalDateTime
  }
  class Role {
    +id: Long
    +name: String
    +description: String
    +createdDate: LocalDateTime
  }
  class Permission {
    +id: Long
